{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.api",
    "watchPatterns": [
      "/services/bauer-evidence-v3/Dockerfile.api",
      "/services/bauer-evidence-v3/bauer_evidence_v3/**",
      "/services/bauer-evidence-v3/migrations/**",
      "/services/bauer-evidence-v3/requirements-api.lock.txt",
      "/services/bauer-evidence-v3/railway.api.json"
    ]
  },
  "deploy": {
    "startCommand": "python -m bauer_evidence_v3.entrypoint api",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ALWAYS",
    "overlapSeconds": 30,
    "drainingSeconds": 30
  }
}
