{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.worker",
    "watchPatterns": [
      "/services/bauer-evidence-v3/Dockerfile.worker",
      "/services/bauer-evidence-v3/bauer_evidence_v3/**",
      "/services/bauer-evidence-v3/migrations/**",
      "/services/bauer-evidence-v3/requirements-worker.lock.txt",
      "/services/bauer-evidence-v3/railway.worker.json"
    ]
  },
  "deploy": {
    "startCommand": "python -m bauer_evidence_v3.entrypoint worker",
    "restartPolicyType": "ALWAYS",
    "drainingSeconds": 120
  }
}
