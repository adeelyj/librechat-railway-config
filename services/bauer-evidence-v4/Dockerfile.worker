FROM python:3.11.15-slim-bookworm@sha256:b18992999dbe963a45a8a4da40ac2b1975be1a776d939d098c647482bcad5cba

ARG DEBIAN_SNAPSHOT=20260724T000000Z

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/home/appuser \
    TZ=UTC \
    BAUER_V3_SERVICE_ROLE=worker

RUN groupadd --gid 10001 appuser \
    && useradd --uid 10001 --gid 10001 --create-home \
      --home-dir /home/appuser --shell /usr/sbin/nologin \
      --no-log-init appuser

RUN sed -i \
      -e "s|http://deb.debian.org/debian-security|https://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT}|g" \
      -e "s|http://deb.debian.org/debian|https://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}|g" \
      /etc/apt/sources.list.d/debian.sources \
    && printf 'Acquire::Check-Valid-Until "false";\n' \
      > /etc/apt/apt.conf.d/99snapshot \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
      libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY services/bauer-evidence-v3/requirements-worker.lock.txt ./
RUN python -m pip install --no-compile --only-binary=:all: \
      --require-hashes --requirement requirements-worker.lock.txt \
    && python -m pip check

COPY --chown=0:0 services/bauer-evidence-v3/bauer_evidence_v3 ./bauer_evidence_v3
COPY --chown=0:0 services/bauer-evidence-v3/migrations ./migrations
COPY --chown=0:0 services/bauer-evidence-v4/bauer_evidence_v4 ./bauer_evidence_v4
COPY --chown=0:0 services/bauer-evidence-v4/migrations ./migrations_v4

USER 10001:10001
STOPSIGNAL SIGTERM
CMD ["python", "-m", "bauer_evidence_v4.deployment.entrypoint", "worker"]
