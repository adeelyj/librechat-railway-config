{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/services/bauer-evidence-v4/Dockerfile.worker",
    "watchPatterns": [
      "/services/bauer-evidence-v3/**",
      "/services/bauer-evidence-v4/**"
    ]
  },
  "deploy": {
    "startCommand": "python -m bauer_evidence_v4.deployment.entrypoint worker",
    "restartPolicyType": "ALWAYS",
    "drainingSeconds": 120
  }
}
