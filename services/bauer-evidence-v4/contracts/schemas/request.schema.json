{
  "$defs": {
    "AuthorizationEnvelope": {
      "additionalProperties": false,
      "properties": {
        "signed_scope": {
          "maxLength": 65536,
          "minLength": 32,
          "title": "Signed Scope",
          "type": "string"
        }
      },
      "required": [
        "signed_scope"
      ],
      "title": "AuthorizationEnvelope",
      "type": "object"
    },
    "ClientContext": {
      "additionalProperties": false,
      "properties": {
        "instance": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Instance",
          "type": "string"
        },
        "type": {
          "enum": [
            "librechat",
            "onix",
            "reference"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "instance"
      ],
      "title": "ClientContext",
      "type": "object"
    },
    "ConversationTurn": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "ConversationTurn",
      "type": "object"
    },
    "TypedConstraint": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Field",
          "type": "string"
        },
        "mandatory": {
          "default": true,
          "title": "Mandatory",
          "type": "boolean"
        },
        "operator": {
          "enum": [
            "eq",
            "neq",
            "in",
            "not_in",
            "gte",
            "lte"
          ],
          "title": "Operator",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "type": "array"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "field",
        "operator",
        "value"
      ],
      "title": "TypedConstraint",
      "type": "object"
    }
  },
  "$id": "https://bauer.example/contracts/v4/request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorization": {
      "$ref": "#/$defs/AuthorizationEnvelope"
    },
    "client": {
      "$ref": "#/$defs/ClientContext"
    },
    "conversation_context": {
      "items": {
        "$ref": "#/$defs/ConversationTurn"
      },
      "maxItems": 12,
      "title": "Conversation Context",
      "type": "array"
    },
    "locale": {
      "default": "de-DE",
      "pattern": "^[A-Za-z]{2}(?:-[A-Za-z0-9]{2,8})?$",
      "title": "Locale",
      "type": "string"
    },
    "question": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "4.0",
      "default": "4.0",
      "title": "Schema Version",
      "type": "string"
    },
    "search_hint": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Search Hint"
    },
    "typed_constraints": {
      "items": {
        "$ref": "#/$defs/TypedConstraint"
      },
      "maxItems": 32,
      "title": "Typed Constraints",
      "type": "array"
    }
  },
  "required": [
    "request_id",
    "question",
    "client",
    "authorization"
  ],
  "title": "V4AnswerRequest",
  "type": "object"
}
